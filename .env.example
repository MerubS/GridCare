# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# Kafka cluster (Confluent Cloud > Cluster > Cluster settings / API keys)
BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-2.aws.confluent.cloud:9092
KAFKA_API_KEY=your-kafka-api-key
KAFKA_API_SECRET=your-kafka-api-secret

# Schema Registry (Confluent Cloud > Environment > Schema Registry)
SR_URL=https://psrc-xxxxx.us-east-2.aws.confluent.cloud
SR_API_KEY=your-schema-registry-key
SR_API_SECRET=your-schema-registry-secret
